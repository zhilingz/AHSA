{
  "cluster_type": "test_cluster",
  "permissions": {
    "file_system": {
      "default_action": "deny",
      "rules": [
        {
          "method": [
            "read"
          ],
          "path_glob": [
            "./README.md",
            "./README.zh.md"
          ]
        },
        {
          "method": [
            "write",
            "append"
          ],
          "path_glob": [
            "./examples/interceptor_run/*"
          ]
        }
      ]
    },
    "exec": {
      "allowed": true,
      "restricted_cmds": [
        "rm -rf",
        "mkfs"
      ]
    },
    "message": {
      "allowed": true,
      "allowed_targets": [
        "feishu:*"
      ]
    }
  }
}
